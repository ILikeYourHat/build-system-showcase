bazel_dep(name = "rules_scala", version = "7.4.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(
    scala_version = "3.10.0",
)

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
scala_deps.scalatest()

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "org.scalatest:scalatest_3:3.2.20",
    ],
    known_contributing_modules = ["protobuf"],
    fetch_sources = True,
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")
