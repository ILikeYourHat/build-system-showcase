#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <version>" >&2
  exit 1
fi

version=$1

semver_regex='^([0-9]*)\.([0-9]*)\.([0-9]*))?$'

if [[ ! $version =~ $semver_regex ]]; then
  echo "Invalid SemVer version: $version" >&2
  exit 1
fi

for dir in */; do
  [[ -d "$dir" ]] || continue
  cd $dir
  printf "$version\n" > .bazelversion
  bazel build //...
  cd ..
done

echo -e "\nBazel versions updated to $version!"
